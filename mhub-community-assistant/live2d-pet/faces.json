{
  "version": 1,
  "updated": "2026-11-06",
  "note": "神情库。一条 = 一个通道上挂着的一组参数，不是一次性播放的动画。规则抄自 WHALEL2D 的 Body.cs（作者手调、2026-11-02 审过）：同一通道新表情替换旧的；不同通道同时存在，碰到同一参数时相加（转头看旁边，头会多转一点）。参数名已换成我们模型的真名（他的 FaceAngleX→ParamAngleX、EyeOpen→ParamEyeLOpen/ROpen 双写）。数值都在 参数词典.json 的 min~max 内。hold 是默认挂多久（秒），到点淡出，不写就 3.5 秒。 头部朝向（歪头/转头/低头/抬头/前探/后仰）不在这里——那个已经有 POSTURES 姿势白名单，两套并存会打架。 tags 是给「她漏写表情时按语义自动补一张脸」用的关键词，规则同 clips.json 的 tags（命中越长的词分越高，2 分才生效）。",
  "channels": [
    "eyes",
    "brows",
    "mouth",
    "tilt",
    "turn",
    "pitch",
    "gaze",
    "lean"
  ],
  "defaults": {
    "hold": 3.5,
    "in": 0.12,
    "out": 0.28
  },
  "faces": {
    "眯眼笑": {
      "ch": "eyes",
      "tags": [
        "开心",
        "高兴",
        "真好",
        "哈哈",
        "好笑",
        "有意思",
        "喜欢",
        "可爱",
        "笑死",
        "嘿嘿",
        "宠溺",
        "太好了"
      ],
      "when": "笑到眼睛弯起来、真心觉得好笑、宠溺",
      "set": {
        "ParamEyeLOpen": 0,
        "ParamEyeROpen": 0,
        "EyeSmile": 1
      }
    },
    "笑眼": {
      "ch": "eyes",
      "tags": [
        "不错",
        "满意",
        "舒服",
        "还行",
        "温柔",
        "轻声",
        "暖暖",
        "挺好"
      ],
      "when": "比眯眼笑轻，眼睛还留着一条缝，边看边笑",
      "set": {
        "ParamEyeLOpen": 0.45,
        "ParamEyeROpen": 0.45,
        "EyeSmile": 1
      }
    },
    "挑眉": {
      "ch": "brows",
      "tags": [
        "真的吗",
        "是吗",
        "确定",
        "怀疑",
        "奇怪",
        "有意思",
        "看穿",
        "怎么",
        "哟"
      ],
      "when": "疑问、看穿了什么、揶揄",
      "set": {
        "ParamBrowLY": 0.6,
        "ParamBrowRY": 0.6,
        "BrowInnerUp": 0.4
      }
    },
    "皱眉": {
      "ch": "brows",
      "tags": [
        "不懂",
        "为什么",
        "怎么办",
        "麻烦",
        "担心",
        "不解",
        "难办",
        "糟糕",
        "有点麻烦",
        "不好办",
        "头疼"
      ],
      "when": "不解、为难、认真起来",
      "set": {
        "ParamBrowLY": -0.8,
        "ParamBrowRY": -0.8,
        "ParamBrowLAngle": -1,
        "ParamBrowRAngle": -1
      }
    },
    "吐舌": {
      "ch": "mouth",
      "tags": [
        "略略略",
        "调皮",
        "鬼脸",
        "逗你",
        "才不"
      ],
      "when": "调皮、扮鬼脸、略略略",
      "set": {
        "TongueOut": 1,
        "ParamMouthOpenY": 0.35
      }
    },
    "嘟嘴": {
      "ch": "mouth",
      "tags": [
        "哼",
        "不理",
        "撒娇",
        "不给",
        "人家",
        "讨厌",
        "想要"
      ],
      "when": "讨要、撒娇、不高兴地撅着",
      "set": {
        "MouthFunnel": 0.7,
        "Mouthpucker": 1,
        "ParamMouthForm": -0.4
      }
    },
    "瘪嘴": {
      "ch": "mouth",
      "tags": [
        "委屈",
        "难过",
        "可惜",
        "不甘心",
        "呜呜",
        "失望"
      ],
      "when": "委屈、要哭不哭",
      "set": {
        "ParamMouthForm": -1
      }
    },
    "斜眼": {
      "ch": "eyes",
      "tags": [
        "嫌弃",
        "无语",
        "你确定",
        "呵呵",
        "服了",
        "白眼",
        "你确定吗",
        "真的假的啊"
      ],
      "when": "瞟、怀疑、有点嫌弃地看过来",
      "set": {
        "REyeSquint": 0.9,
        "LEyeSquint": 0.9,
        "ParamEyeLOpen": 0.7,
        "ParamEyeROpen": 0.7
      }
    },
    "睁大": {
      "ch": "eyes",
      "tags": [
        "居然",
        "真的假的",
        "吓",
        "惊",
        "什么",
        "天哪",
        "竟然",
        "不会吧"
      ],
      "when": "吃惊、瞪大眼睛、认真看你",
      "set": {
        "ParamEyeLOpen": 1.35,
        "ParamEyeROpen": 1.35
      }
    },
    "半睁": {
      "ch": "eyes",
      "tags": [
        "困",
        "累了",
        "好懒",
        "无聊",
        "没劲",
        "好烦",
        "哈欠",
        "睡了",
        "好累",
        "不想动",
        "没力气",
        "好困",
        "累死",
        "躺"
      ],
      "when": "犯困、没精神、慵懒",
      "set": {
        "ParamEyeLOpen": 0.45,
        "ParamEyeROpen": 0.45
      }
    },
    "闭眼": {
      "ch": "eyes",
      "tags": [
        "享受",
        "懂了",
        "明白",
        "好吧",
        "知道啦"
      ],
      "when": "享受、点头应下、不想看",
      "set": {
        "ParamEyeLOpen": 0,
        "ParamEyeROpen": 0
      }
    },
    "眨单眼": {
      "ch": "eyes",
      "tags": [
        "保密",
        "秘密",
        "交给我",
        "懂的",
        "放心",
        "嘘"
      ],
      "when": "使眼色、俏皮地眨眼",
      "set": {
        "ParamEyeLOpen": 0,
        "ParamEyeROpen": 1,
        "EyeSmile": 1
      }
    },
    "八字眉": {
      "ch": "brows",
      "tags": [
        "求你了",
        "帮帮我",
        "可怜",
        "拜托",
        "抱歉",
        "对不起"
      ],
      "when": "为难、可怜巴巴、求饶",
      "set": {
        "BrowInnerUp": 1,
        "ParamBrowLAngle": 0.6,
        "ParamBrowRAngle": 0.6
      }
    },
    "微笑": {
      "ch": "mouth",
      "tags": [
        "好的",
        "可以",
        "没问题",
        "谢谢",
        "当然",
        "收到",
        "嗯嗯",
        "行吧",
        "改好",
        "看下",
        "回头",
        "在的"
      ],
      "when": "礼貌地笑、心情不错",
      "set": {
        "ParamMouthForm": 1
      }
    },
    "大笑": {
      "ch": "mouth",
      "tags": [
        "太棒",
        "太好了",
        "好耶",
        "绝了",
        "太开心",
        "哈哈哈"
      ],
      "when": "真的笑出来、开心到出声",
      "set": {
        "ParamMouthForm": 1,
        "ParamMouthOpenY": 0.6,
        "JawOpen": 0.3
      }
    },
    "坏笑": {
      "ch": "mouth",
      "tags": [
        "故意",
        "捉弄",
        "你猜",
        "小坏",
        "有点意思"
      ],
      "when": "打坏主意、逗你",
      "set": {
        "ParamMouthForm": 1,
        "MouthX": 0.6
      }
    },
    "张嘴": {
      "ch": "mouth",
      "tags": [
        "哇",
        "咦",
        "愣住",
        "突然",
        "没想到"
      ],
      "when": "要说话、愣住、啊了一声",
      "set": {
        "ParamMouthOpenY": 0.7,
        "JawOpen": 0.4,
        "MouthFunnel": 0.3
      }
    },
    "抿嘴": {
      "ch": "mouth",
      "tags": [
        "忍住",
        "不能说",
        "不好说",
        "憋着"
      ],
      "when": "忍着不说、憋着笑、不赞同但不出声",
      "set": {
        "MouthPressLipOpen": -1,
        "ParamMouthForm": -0.5
      }
    },
    "看左边": {
      "ch": "gaze",
      "tags": [
        "那个",
        "让我想想",
        "说起来",
        "旁边"
      ],
      "when": "视线往左瞟",
      "set": {
        "ParamEyeBallX": 0.75,
        "ParamAngleX": 7
      }
    },
    "看右边": {
      "ch": "gaze",
      "tags": [
        "不对",
        "等等",
        "那边",
        "可是"
      ],
      "when": "视线往右瞟",
      "set": {
        "ParamEyeBallX": -0.75,
        "ParamAngleX": -7
      }
    },
    "看上面": {
      "ch": "gaze",
      "tags": [
        "想想",
        "回忆",
        "大概",
        "应该",
        "估计"
      ],
      "when": "眼神飘上去想事情",
      "set": {
        "ParamEyeBallY": 0.6,
        "ParamAngleY": 4
      }
    },
    "看下面": {
      "ch": "gaze",
      "tags": [
        "不好意思",
        "害羞",
        "抱歉",
        "算了"
      ],
      "when": "视线落下来，害羞或沮丧",
      "set": {
        "ParamEyeBallY": -0.6,
        "ParamAngleY": -5
      }
    },
    "脸红": {
      "ch": "blush",
      "tags": [
        "夸我",
        "心动",
        "好帅",
        "真厉害",
        "宝贝",
        "被夸"
      ],
      "expr": "脸红",
      "when": "被夸到、害羞、心动",
      "set": {}
    },
    "黑脸": {
      "ch": "blush",
      "tags": [
        "离谱",
        "什么鬼",
        "过分",
        "不能忍",
        "受不了了"
      ],
      "expr": "黑脸",
      "when": "无语、被雷到",
      "set": {}
    },
    "爱心眼": {
      "ch": "blush",
      "tags": [
        "爱你",
        "可爱死",
        "想你",
        "迷住"
      ],
      "expr": "爱心眼",
      "when": "心动了、被迷住",
      "set": {}
    },
    "圈圈眼": {
      "ch": "blush",
      "tags": [
        "晕了",
        "太多",
        "听不懂",
        "绕",
        "转不过来",
        "信息量"
      ],
      "expr": "圈圈眼",
      "when": "晕了、转不过来",
      "set": {}
    },
    "＞＜": {
      "ch": "blush",
      "tags": [
        "崩溃",
        "受不了",
        "要死",
        "难顶",
        "疯了"
      ],
      "expr": "＞＜",
      "when": "崩溃、受不了了",
      "set": {}
    },
    "屑屑眼": {
      "ch": "blush",
      "tags": [
        "得意",
        "早就说",
        "你看吧",
        "厉害吧",
        "小看",
        "我猜"
      ],
      "expr": "屑屑眼",
      "when": "得意、小得意地看你",
      "set": {}
    },
    "流冷汗": {
      "ch": "blush",
      "tags": [
        "尴尬",
        "心虚",
        "呃",
        "好像",
        "完了"
      ],
      "expr": "流冷汗",
      "when": "尴尬、心虚",
      "set": {}
    },
    "流泪": {
      "ch": "blush",
      "tags": [
        "感动",
        "哭了",
        "舍不得",
        "心疼",
        "眼泪"
      ],
      "expr": "流泪",
      "when": "委屈到哭、感动",
      "set": {}
    }
  }
}